# Copiare in deploy/.env e compilare. NON salvare mai il file .env nella repo.
POSA_DOMINIO=posa.tuodominio.it
POSA_URL_PUBBLICO=https://posa.tuodominio.it

# chiave Anthropic per gli agenti (console.anthropic.com)
ANTHROPIC_API_KEY=
# Client secret dell'app Shopify (Partner Dashboard): firma App Proxy e webhook
SHOPIFY_API_SECRET=
# segreto dell'endpoint webhook di Stripe (whsec_...): i pagamenti attivano/sospendono i
# clienti. Facoltativo: senza, lo stato dei clienti si cambia a mano (docs/SAAS.md)
STRIPE_WEBHOOK_SECRET=
# token di amministrazione: clienti, piani, chiavi (generare con: python -c "import secrets;print(secrets.token_urlsafe(32))")
POSA_ADMIN_TOKEN=
# chiave dei permessi di caricamento (come sopra)
POSA_CHIAVE_CARICAMENTI=

# limiti (valori di partenza)
# prove al giorno per cliente, se non indicato alla creazione (la quota mensile è nel piano)
POSA_PRATICHE_NEGOZIO_GIORNO=100
POSA_PRATICHE_IP_ORA=6
POSA_PRATICHE_IN_PARALLELO=2
POSA_BUDGET_PRATICA_USD=4.0
POSA_CONSERVAZIONE_GIORNI=7
# 1 = tiene anche foto originale e immagini di lavoro delle prove consegnate fino alla
# scadenza (solo per indagare un problema: di norma restano solo i risultati)
POSA_TIENI_LAVORAZIONE=0
